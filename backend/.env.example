APP_NAME=CommitIt
VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Optional. Leave unset to run in fully deterministic mode (no AI
# features are required for the rest of the app to work). If set, the
# /ai/explain endpoint will use Gemini by default instead of the
# deterministic Explanation Engine, automatically falling back if the
# key is invalid or the request fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# JWT secret key for auth session signing (change in production)
JWT_SECRET_KEY=dev_secret_key_change_me_in_production
# Repository storage directory
REPO_STORAGE_DIR=repositories
# Database URL
DATABASE_URL=sqlite:///commitit.db
